generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(cuid())
  name                String?
  email               String?          @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole         @default(MEMBER)
  status              UserStatus       @default(PENDING)
  lastAuthenticatedAt DateTime?
  disabledAt          DateTime?
  deletedAt           DateTime?
  accounts            Account[]
  sessions            Session[]
  authenticators      Authenticator[]
  transactions        Transaction[]    @relation("TransactionActor")
  teamMemberships     TeamMembership[] @relation("TeamMembershipUser")
  approvedMemberships TeamMembership[] @relation("TeamMembershipApprovedBy")
  createdTeams        Team[]           @relation("TeamCreator")
  deletedTeams        Team[]           @relation("TeamDeletedBy")
  sentInvitations     Invitation[]     @relation("InvitationInviter")
  receivedInvitation  Invitation?      @relation("InvitationUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Transaction {
  id                String          @id @default(cuid())
  teamId            String
  userId            String?
  idempotencyKey    String          @db.VarChar(64)
  actorIdSnapshot   String
  actorNameSnapshot String
  type              TransactionType
  amountInCents     Int
  note              String?         @db.VarChar(240)
  transactionDate   DateTime        @db.Date
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy         User?           @relation("TransactionActor", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, idempotencyKey])
  @@index([userId, transactionDate, createdAt])
  @@index([teamId, transactionDate, createdAt, id])
  @@index([teamId, type])
  @@index([transactionDate, createdAt, id])
}

model Team {
  id           String           @id @default(cuid())
  name         String           @unique @db.VarChar(80)
  description  String?          @db.VarChar(240)
  createdById  String
  deletedById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  purgeAfter   DateTime?
  createdBy    User             @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy    User?            @relation("TeamDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  memberships  TeamMembership[]
  transactions Transaction[]

  @@index([createdById])
  @@index([deletedAt, purgeAfter])
  @@index([deletedById])
}

model Invitation {
  id                String           @id @default(cuid())
  email             String           @unique @db.VarChar(254)
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  invitedById       String?
  provisionedUserId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  inviter           User?            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  provisionedUser   User?            @relation("InvitationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([invitedById])
}

/// Append-only security and administrative record. The migration installs a
/// database trigger that rejects UPDATE/DELETE outside an explicit maintenance
/// transaction. Snapshot identifiers deliberately have no foreign keys, so
/// user/team lifecycle operations cannot cascade into audit history.
model AuditEvent {
  id                String   @id @default(cuid())
  action            String   @db.VarChar(80)
  actorUserId       String?  @db.VarChar(191)
  actorIdSnapshot   String   @db.VarChar(191)
  actorNameSnapshot String   @db.VarChar(160)
  targetType        String   @db.VarChar(40)
  targetIdSnapshot  String   @db.VarChar(191)
  teamIdSnapshot    String?  @db.VarChar(191)
  correlationId     String   @db.VarChar(64)
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetIdSnapshot, createdAt])
  @@index([teamIdSnapshot, createdAt])
  @@index([correlationId])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String   @db.VarChar(64)
  subjectHash String   @db.VarChar(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@unique([scope, subjectHash, windowStart])
  @@index([expiresAt])
}

model TeamMembership {
  id           String               @id @default(cuid())
  teamId       String
  userId       String
  role         TeamMemberRole       @default(MEMBER)
  status       TeamMembershipStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User                 @relation("TeamMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?                @relation("TeamMembershipApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status, role])
}

enum UserRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  DELETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TeamMemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum TeamMembershipStatus {
  PENDING
  APPROVED
  REVOKED
}

enum TransactionType {
  ADD
  REMOVE
}
