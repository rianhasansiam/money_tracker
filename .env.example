# Normal application database (required for development and production runtime)
DATABASE_URL="postgresql://app_user:app_password@127.0.0.1:5432/money_tracker"

# Loopback origin of a separately started production server (required only for E2E tests)
E2E_BASE_URL=http://127.0.0.1:3000

# Auth.js and Google OAuth (required for an interactive application deployment)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required for production self-hosting; omit on Vercel. Use the canonical HTTPS origin.
AUTH_URL=https://money-tracker.example.test

# First-administrator bootstrap (required only while running db:bootstrap-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
