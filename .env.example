# Normal application database (required for development and production runtime)
DATABASE_URL="postgresql://app_user:app_password@127.0.0.1:5432/money_tracker"

# Loopback origin of a separately started production server (required only for E2E tests)
E2E_BASE_URL=http://127.0.0.1:3000

# Tests only: an independently disposable database, never the application target.
TEST_DATABASE_URL="postgresql://test_user:test_password@127.0.0.1:5432/money_tracker_test"
# Remote disposable targets additionally require explicit confirmation and TLS.
# TEST_DATABASE_ALLOW_REMOTE=true
# TEST_DATABASE_CONFIRMATION=I_ACKNOWLEDGE_THIS_TEST_DATABASE_WILL_BE_CLEARED

# Auth.js and Google OAuth (required for an interactive application deployment)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional dedicated random secret, at least 16 characters; falls back to AUTH_SECRET.
# RATE_LIMIT_HASH_SECRET=
# Set only behind a controlled proxy that overwrites forwarding headers.
# TRUSTED_PROXY_MODE=forwarded

# Required for production self-hosting; omit on Vercel. Use the canonical HTTPS origin.
AUTH_URL=https://money-tracker.example.test

# First-administrator bootstrap (required only while running db:bootstrap-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
